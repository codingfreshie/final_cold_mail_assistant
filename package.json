{
  "name": "chatbot-app",
  "version": "1.0.0",
  "description": "Full-stack chatbot application with React frontend and Node.js backend",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": ["chatbot", "react", "nodejs", "authentication", "openai"],
  "author": "",
  "license": "MIT"
} 